---
// src/pages/index.astro
// Central Production 3 Majalengka — Production Dashboard
// Layout: rail kiri (produk/shift/tanggal + foreman) + 9 kotak 3x3
// Box 8-9: TOP 5 LATE & TOP 5 NORMAL OVERTIME (sheet Leaderboard 5R via Supabase)
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Dashboard produksi Central Production 3 Majalengka — monitor KPI shiftly/monthly/weekly dari Supabase." />
    <title>Central Production 3 Majalengka — Dashboard Produksi</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>

  <body>
    <div id="app" class="app-wrapper">

      <!-- ====== HEADER ====== -->
      <header class="glass main-header" id="mainHeader">
        <div class="header-logos">
          <img
            src="https://bkk.smk-unsur.sch.id/assets/logo_perusahaan/25d7a6441a1880fddfb6a915546feb0a.png"
            alt="Logo Perusahaan"
            class="header-logo"
            onerror="this.style.display='none'"
          />
        </div>
        <h1>CENTRAL PRODUCTION 3 MAJALENGKA</h1>
        <div class="header-right">
          <div class="toast" id="syncToast">
            <div class="toast-dot live-dot" id="syncDot" style="background: #64748b;"></div>
            <span id="syncText">Menghubungkan...</span>
          </div>
        </div>
      </header>

      <!-- ====== BODY: rail kiri + 9 kotak ====== -->
      <main class="dash-grid">

        <!-- === RAIL KIRI === -->
        <aside class="rail-col">
          <div class="glass pill" id="productPill" onclick="cycleProduct()" title="Klik untuk ganti produk">
            <div class="pill-cap">PRODUK</div>
            <div id="productLabel">—</div>
          </div>

          <div class="glass pill" id="shiftPill" onclick="cycleShift()" title="Klik untuk ganti shift">
            <div class="pill-cap">SHIFT</div>
            <div id="shiftLabel">—</div>
          </div>

          <div class="glass pill" style="cursor:default;">
            <div class="pill-cap">TANGGAL PRODUKSI</div>
            <div id="dateDateLabel" style="font-weight:800;">—</div>
          </div>

          <div class="glass foreman-card">
            <div class="box-label">FOREMAN PRODUKSI</div>
            <div class="foreman-prod" id="foremanProdLabel">—</div>
            <div id="foremanBox" class="foreman-list">
              <div style="font-size:11px; color:var(--text-muted);">Memuat...</div>
            </div>
          </div>
        </aside>

        <!-- === 9 KOTAK 3x3 === -->
        <section class="boxes-grid">
          <!-- Baris 1 -->
          <div class="glass box">
            <div class="box-label">STANDARD / OUTPUT <span>shiftly</span></div>
            <div class="box-value success" id="boxOutput">—</div>
          </div>
          <div class="glass box">
            <div class="box-label">PROCESS SCORE <span>monthly</span></div>
            <div class="box-value teal" id="boxProcess">—</div>
          </div>
          <div class="glass box">
            <div class="box-label">PRODUCT SCORE <span>monthly</span></div>
            <div class="box-value gold" id="boxProductScore">—</div>
          </div>

          <!-- Baris 2 -->
          <div class="glass box">
            <div class="box-label">YIELD <span>shiftly</span></div>
            <div class="box-value teal" id="boxYield">—</div>
          </div>
          <div class="glass box">
            <div class="box-label">GMP <span>monthly</span></div>
            <div class="box-value teal" id="boxGmp">—</div>
          </div>
          <div class="glass box">
            <div class="box-label">5R <span>monthly</span></div>
            <div class="box-value teal" id="boxSr">—</div>
          </div>

          <!-- Baris 3 -->
          <div class="glass box">
            <div class="box-label">WASTE <span>shiftly</span></div>
            <div class="box-value danger" id="boxWaste">—</div>
          </div>
          <div class="glass box">
            <div class="box-label">TOP 5 LATE <span>weekly</span></div>
            <ol id="boxLate" class="box-top5"><li>Memuat...</li></ol>
          </div>
          <div class="glass box">
            <div class="box-label">TOP 5 NORMAL OVERTIME <span>weekly</span></div>
            <ol id="boxOt" class="box-top5"><li>Memuat...</li></ol>
          </div>
        </section>

      </main>

      <!-- ====== FOOTER ====== -->
      <footer class="footer-bar">
        <div id="tvBar" class="tv-bar" style="display:none;">
          <div class="toast-dot live-dot" style="background:red; flex-shrink:0;"></div>
          <span id="tvBarText">Mode TV</span>
          <span id="tvBarCount" style="font-weight:900; tabular-nums;">0</span>s
        </div>

        <div style="flex:1;"></div>

        <div style="font-size:11px; color: var(--text-muted); font-weight:600;">
          Update terakhir: <span id="lastUpdateTime" style="color: var(--text-secondary);">—</span>
        </div>

        <div class="glass" style="padding: 6px 12px; border-radius: 14px; display:flex; align-items:center; gap:8px;">
          <select id="tvInterval" class="filter-select" style="font-size:12px; width:auto; font-weight:700;" onchange="onTvIntervalChange()">
            <option value="5000">5 dtk</option>
            <option value="8000" selected>8 dtk</option>
            <option value="15000">15 dtk</option>
            <option value="30000">30 dtk</option>
          </select>
          <button id="tvBtn" onclick="toggleTvMode()"
            style="background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 5px 12px; color: var(--text-primary); font-family: inherit; font-weight: 700; font-size: 11px; cursor: pointer; transition: all 0.2s; letter-spacing:0.04em;">
            ▶ Mode TV
          </button>
        </div>
      </footer>

    </div>

    <!-- ====== LAYOUT STYLES ====== -->
    <style>
      html, body { overflow: hidden; height: 100%; }

      .app-wrapper {
        height: 100dvh;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 8px 10px;
        position: relative;
        z-index: 1;
      }

      #mainHeader { flex-shrink: 0; min-height: 58px; }
      .header-logos { display: flex; gap: 8px; align-items: center; }
      .header-right { display: flex; align-items: center; }

      /* Grid utama: rail kiri + 9 kotak */
      .dash-grid {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(180px, 22%) 1fr;
        gap: 8px;
        overflow: hidden;
      }

      .rail-col {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-height: 0;
        overflow: hidden;
      }

      .pill-cap {
        font-size: 10px;
        opacity: 0.5;
        margin-bottom: 2px;
        font-weight: 700;
        letter-spacing: 0.06em;
      }

      /* Kartu foreman: mengisi sisa tinggi rail */
      .foreman-card {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 12px 10px;
        gap: 4px;
        overflow: hidden;
      }

      .foreman-prod {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.05em;
      }

      .foreman-list {
        flex: 1;
        min-height: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-evenly;
        gap: 8px;
        overflow: hidden;
      }

      .foreman-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        min-width: 0;
      }

      .foreman-img {
        width: clamp(56px, 9vh, 84px);
        height: clamp(56px, 9vh, 84px);
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--teal);
        box-shadow: 0 0 14px rgba(0,179,216,0.4);
        background: rgba(0,179,216,0.1);
      }

      .foreman-ph {
        width: clamp(56px, 9vh, 84px);
        height: clamp(56px, 9vh, 84px);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 900;
        background: rgba(0,179,216,0.12);
        border: 3px dashed rgba(0,179,216,0.4);
        color: var(--teal);
      }

      .foreman-name {
        font-size: 11px;
        font-weight: 700;
        text-align: center;
        line-height: 1.25;
        color: var(--text-primary);
        word-break: break-word;
        max-width: 100%;
      }

      /* 9 kotak 3x3 */
      .boxes-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(3, 1fr);
        gap: 8px;
        min-height: 0;
        overflow: hidden;
      }

      .box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 12px 10px;
        gap: 6px;
        min-height: 0;
        overflow: hidden;
      }

      .box-label {
        font-size: clamp(10px, 1.6vh, 13px);
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-secondary);
        line-height: 1.35;
      }

      .box-label span {
        font-weight: 400;
        font-style: italic;
        font-size: 0.85em;
        color: var(--text-muted);
      }

      .box-value {
        font-size: clamp(18px, 4vh, 40px);
        font-weight: 900;
        line-height: 1.1;
        letter-spacing: -0.02em;
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
      }

      .box-value.teal    { color: var(--teal); }
      .box-value.magenta { color: var(--magenta); }
      .box-value.gold    { color: var(--gold); }
      .box-value.danger  { color: var(--danger); }
      .box-value.success { color: var(--success); }
      .box-value.muted   { color: var(--text-muted); font-size: clamp(14px, 2.5vh, 22px); }

      .kpi-unit {
        font-size: 0.45em;
        font-weight: 700;
        opacity: 0.8;
        letter-spacing: 0.05em;
      }

      /* List Top 5 di dalam kotak */
      .box-top5 {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
      }

      .box-top5 li {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: clamp(10px, 1.7vh, 13px);
        font-weight: 600;
        background: rgba(255,255,255,0.05);
        border-radius: 9px;
        padding: 4px 10px;
        white-space: nowrap;
        overflow: hidden;
        text-align: left;
      }

      .box-top5 li span:last-child {
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .top5-rank {
        font-weight: 900;
        color: var(--gold);
        min-width: 20px;
        text-align: center;
        flex-shrink: 0;
      }

      .footer-bar {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 4px 4px;
        font-size: 11px;
      }

      @media (max-width: 900px) {
        .dash-grid { grid-template-columns: 1fr; grid-template-rows: auto 1fr; overflow-y: auto; }
        html, body { overflow: auto; }
        .boxes-grid { grid-template-columns: 1fr 1fr; grid-template-rows: none; }
        .foreman-card { min-height: 220px; }
      }
    </style>

    <!-- ====== SCRIPT UTAMA ====== -->
    <script type="module">
      import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm';

      const SUPABASE_URL = 'https://awnjjzyyyxflvhpsnwby.supabase.co';
      const SUPABASE_KEY = 'sb_publishable_F2QptrbgTXqFo8pZvtNgZg_mAfhuUSS';
      const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

      // ---- State ----
      const PRODUCTS = ['SIOMAY','UDANG KEJU','PENTOL','ADONAN PANGSIT','AYAM CINCANG','LUMPIA','KERUPUK MIE','KULIT PANGSIT','MIE','CABAI'];
      const SHIFTS   = ['Shift 1','Shift 2','Shift 3','ALL SHIFT'];
      let productIdx = 0, shiftIdx = 1;

      const PRODUCT_COLORS = {
        'SIOMAY':'#00b3d8','UDANG KEJU':'#ec008d','PENTOL':'#10b981',
        'ADONAN PANGSIT':'#a78bfa','AYAM CINCANG':'#f97316','LUMPIA':'#ec4899',
        'KERUPUK MIE':'#f59e0b','KULIT PANGSIT':'#14b8a6','MIE':'#6366f1','CABAI':'#22c55e'
      };

      let tvActive = false, tvTimer = null, tvCountdown = 0, tvCountTimer = null;
      let reqSeq = 0;
      let tvCombos = [];
      let tvIndex = 0;

      // ---- Init ----
      window.addEventListener('DOMContentLoaded', () => {
        updatePills();
        loadDashboardData();
        subscribeRealtime();
        setInterval(loadDashboardData, 5 * 60 * 1000); // refresh tiap 5 menit
      });

      function updatePills() {
        document.getElementById('productLabel').textContent = PRODUCTS[productIdx];
        document.getElementById('shiftLabel').textContent   = SHIFTS[shiftIdx];
        const color = PRODUCT_COLORS[PRODUCTS[productIdx]] || '#00b3d8';
        document.getElementById('productLabel').style.color = color;
      }

      window.cycleProduct = function() {
        if (tvActive) return;
        productIdx = (productIdx + 1) % PRODUCTS.length;
        updatePills();
        loadDashboardData();
      };

      window.cycleShift = function() {
        if (tvActive) return;
        shiftIdx = (shiftIdx + 1) % SHIFTS.length;
        updatePills();
        loadDashboardData();
      };

      // ---- Load data dari Supabase ----
      async function loadDashboardData() {
        const seq = ++reqSeq;
        setSyncStatus('loading');

        try {
          const [{ data: dashData, error: dashErr }, { data: rank5r }, { data: foreman5r }] = await Promise.all([
            supabase.from('dashboard_khusus').select('*').order('row_index', { ascending: false }).limit(200),
            supabase.from('leaderboard_5r_ranking').select('*').order('rank', { ascending: true }).limit(20),
            supabase.from('leaderboard_5r_foreman').select('*').order('row_index', { ascending: true }).limit(50)
          ]);

          if (dashErr) throw dashErr;

          const { data: syncData } = await supabase
            .from('sync_log')
            .select('*')
            .eq('id', 'last_sync')
            .single();

          if (seq !== reqSeq) return; // Stale response

          renderDashboard(dashData || [], rank5r || [], foreman5r || [], syncData);
          setSyncStatus('ok');
        } catch (err) {
          console.error('[DASHBOARD] Error:', err.message);
          if (seq === reqSeq) setSyncStatus('error');
        }
      }

      // ---- Render Dashboard ----
      function renderDashboard(dashData, rank5r, foreman5r, syncData) {
        const selectedProduct = PRODUCTS[productIdx];
        const selectedShift   = SHIFTS[shiftIdx];

        const kpis = extractKPIs(dashData, selectedProduct, selectedShift);

        setBox('boxOutput',       kpis.outputVsStd,  'success');
        setBox('boxProcess',      kpis.processScore, 'teal');
        setBox('boxProductScore', kpis.productScore, 'gold');
        setBox('boxYield',        kpis.yield,        'teal');
        setBox('boxGmp',          kpis.gmp,          'teal');
        setBox('boxSr',           kpis.sr,           'teal');
        setBox('boxWaste',        kpis.waste,        'danger');

        document.getElementById('dateDateLabel').textContent = kpis.dateLabel || '—';

        renderTop5(rank5r);
        renderForeman(foreman5r, selectedProduct);

        if (syncData && syncData.timestamp) {
          const d = new Date(syncData.timestamp);
          document.getElementById('lastUpdateTime').textContent = d.toLocaleString('id-ID', {
            day:'2-digit', month:'short', year:'numeric',
            hour:'2-digit', minute:'2-digit'
          });
        }
      }

      // ---- Ekstrak KPI dari data dashboard_khusus ----
      function extractKPIs(rows, selectedProduct, selectedShift) {
        const kpis = {
          output: null, stdPlan: null,
          yield: null, waste: null,
          gmp: null, processScore: null, productScore: null, sr: null,
          outputVsStd: null, dateLabel: null
        };

        if (!rows || rows.length === 0) return formatKPIs(kpis);

        const latestRow = rows.find(r => r.tanggal && r.tanggal !== null) || rows[0];
        if (latestRow && latestRow.tanggal) {
          kpis.dateLabel = String(latestRow.tanggal).substring(0, 10);
        }

        const prodKey   = selectedProduct.toLowerCase().replace(/[^a-z0-9]/g, '_');
        const shiftKey  = selectedShift.toLowerCase().replace(/[^a-z0-9]/g, '_');
        const isAllShift = selectedShift === 'ALL SHIFT';
        const allKeys = Object.keys(latestRow);

        function numVal(v) {
          const n = parseFloat(String(v ?? '').replace(/[^0-9.-]/g, ''));
          return isNaN(n) ? null : n;
        }

        // Kolom shiftly: harus cocok produk + shift
        function findShiftly(kpiType) {
          for (const key of allKeys) {
            const k = key.toLowerCase();
            const matchProd  = k.includes(prodKey) || prodKey.split('_').some(p => p.length > 2 && k.includes(p));
            const matchShift = isAllShift || k.includes(shiftKey);
            if (matchProd && matchShift && k.includes(kpiType)) {
              const v = numVal(latestRow[key]);
              if (v !== null) return v;
            }
          }
          return null;
        }

        // Kolom monthly: cocok produk dulu, abaikan shift; fallback cocok tipe saja
        function findMonthly(tests) {
          const preds = Array.isArray(tests) ? tests : [tests];
          for (const key of allKeys) {
            const k = key.toLowerCase();
            const matchProd = k.includes(prodKey) || prodKey.split('_').some(p => p.length > 2 && k.includes(p));
            if (matchProd && preds.some(fn => fn(k))) {
              const v = numVal(latestRow[key]);
              if (v !== null) return v;
            }
          }
          for (const key of allKeys) {
            const k = key.toLowerCase();
            if (preds.some(fn => fn(k))) {
              const v = numVal(latestRow[key]);
              if (v !== null) return v;
            }
          }
          return null;
        }

        // Shiftly
        kpis.output  = findShiftly('actual') || findShiftly('output') || findShiftly('fg');
        kpis.stdPlan = findShiftly('std') || findShiftly('ppic') || findShiftly('standard');
        kpis.yield   = findShiftly('yield');
        kpis.waste   = findShiftly('waste') || findShiftly('reject');

        // Monthly (abaikan shift)
        kpis.gmp          = findMonthly(k => k.includes('gmp'));
        kpis.sr           = findMonthly([k => k.includes('5r'), k => /(^|_)sr($|_)/.test(k)]);
        kpis.processScore = findMonthly([k => k.includes('process'), k => k.includes('proses')]);
        kpis.productScore = findMonthly([
          k => k.includes('product_score') || k.includes('productscore'),
          k => k.includes('product') && k.includes('score') && !k.includes('productiv')
        ]);

        return formatKPIs(kpis);
      }

      function formatKPIs(kpis) {
        function fmt(v, suffix='') {
          if (v === null || v === undefined || isNaN(v)) return null;
          return Math.round(v).toLocaleString('id-ID') + (suffix ? ' ' + suffix : '');
        }
        function fmtPct(v) {
          if (v === null || v === undefined || isNaN(v)) return null;
          const pct = v <= 1 ? v * 100 : v;
          return pct.toFixed(1) + '%';
        }
        function fmtScore(v) {
          if (v === null || v === undefined || isNaN(v)) return null;
          return (Math.round(v * 10) / 10).toLocaleString('id-ID', { maximumFractionDigits: 1 });
        }

        return {
          yield:        fmtPct(kpis.yield),
          waste:        fmt(kpis.waste, 'Kg'),
          gmp:          fmtScore(kpis.gmp),
          processScore: fmtScore(kpis.processScore),
          productScore: fmtScore(kpis.productScore),
          sr:           fmtScore(kpis.sr),
          outputVsStd:  (kpis.output !== null && kpis.stdPlan !== null)
                          ? `${fmt(kpis.output)} / ${fmt(kpis.stdPlan)}`
                          : fmt(kpis.output, 'Pack'),
          dateLabel:    kpis.dateLabel
        };
      }

      // ---- Box 8-9: TOP 5 LATE / TOP 5 OVERTIME (weekly, dari sheet Leaderboard 5R) ----
      function renderTop5(ranking) {
        const lateEl = document.getElementById('boxLate');
        const otEl   = document.getElementById('boxOt');
        const sorted = [...(ranking || [])].sort((a, b) => (a.rank || 99) - (b.rank || 99));
        const lates = sorted.map(r => r.top_late).filter(v => v && String(v).trim() !== '').slice(0, 5);
        const ots   = sorted.map(r => r.top_overtime).filter(v => v && String(v).trim() !== '').slice(0, 5);

        const medals = ['🥇','🥈','🥉','4','5'];
        lateEl.innerHTML = lates.length === 0
          ? '<li style="color:var(--text-muted); background:none; justify-content:center;">— belum ada data —</li>'
          : lates.map((n, i) => `<li><span class="top5-rank">${medals[i] || (i+1)}</span><span>${escapeHtml(String(n))}</span></li>`).join('');
        otEl.innerHTML = ots.length === 0
          ? '<li style="color:var(--text-muted); background:none; justify-content:center;">— belum ada data —</li>'
          : ots.map((n, i) => `<li><span class="top5-rank">${medals[i] || (i+1)}</span><span>${escapeHtml(String(n))}</span></li>`).join('');
      }

      // ---- Rail kiri: FOREMAN PRODUKSI (foto by IMG URL dari sheet Leaderboard 5R) ----
      const PROD_ALIAS = {
        'KERUPUK MIE': ['KM/KP', 'KERUPUK MIE', 'KM', 'MIE'],
        'KULIT PANGSIT': ['KM/KP', 'KULIT PANGSIT', 'KP'],
        'MIE': ['MIE', 'KM/KP']
      };

      function normalizeImgUrl(url) {
        if (!url) return null;
        const u = String(url).trim();
        if (!u) return null;
        let m = u.match(/drive\.google\.com\/(?:file\/d\/|open\?id=|uc\?id=)([a-zA-Z0-9_-]+)/)
             || u.match(/[?&]id=([a-zA-Z0-9_-]{10,})/);
        if (m && m[1]) return `https://drive.google.com/thumbnail?id=${m[1]}&sz=w200`;
        const m2 = u.match(/\/d\/([a-zA-Z0-9_-]{10,})/);
        if (u.includes('drive.google') && m2 && m2[1]) return `https://drive.google.com/thumbnail?id=${m2[1]}&sz=w200`;
        return u;
      }

      function matchForemanRow(foremen, product) {
        if (!foremen || foremen.length === 0) return null;
        const p = String(product || '').toUpperCase().trim();
        let row = foremen.find(r => String(r.prod || '').toUpperCase().trim() === p);
        if (row) return row;
        const aliases = PROD_ALIAS[p] || [p];
        row = foremen.find(r => aliases.includes(String(r.prod || '').toUpperCase().trim()));
        if (row) return row;
        return foremen.find(r => {
          const v = String(r.prod || '').toUpperCase().trim();
          return v && (p.includes(v) || v.includes(p));
        }) || null;
      }

      function renderForeman(foremen, selectedProduct) {
        const box = document.getElementById('foremanBox');
        const prodLabel = document.getElementById('foremanProdLabel');
        if (!box) return;
        prodLabel.textContent = selectedProduct || '—';

        const row = matchForemanRow(foremen, selectedProduct);
        if (!row) {
          box.innerHTML = '<div style="font-size:11px; color:var(--text-muted);">— belum ada data —</div>';
          return;
        }
        const items = [
          { name: row.foreman_1, img: normalizeImgUrl(row.img_1) },
          { name: row.foreman_2, img: normalizeImgUrl(row.img_2) },
          { name: row.foreman_3, img: normalizeImgUrl(row.img_3) }
        ].filter(it => (it.name && String(it.name).trim() !== '') || it.img);

        if (items.length === 0) {
          box.innerHTML = '<div style="font-size:11px; color:var(--text-muted);">— belum ada data —</div>';
          return;
        }
        box.innerHTML = items.map(it => {
          const nm = (it.name && String(it.name).trim() !== '') ? String(it.name).trim() : '—';
          const initial = escapeHtml(nm.charAt(0).toUpperCase() || '?');
          const visual = it.img
            ? `<img class="foreman-img" src="${escapeHtml(it.img)}" alt="${escapeHtml(nm)}" loading="lazy" onerror="this.outerHTML='<div class=&quot;foreman-ph&quot;>${initial}</div>'" />`
            : `<div class="foreman-ph">${initial}</div>`;
          return `<div class="foreman-item">${visual}<div class="foreman-name">${escapeHtml(nm)}</div></div>`;
        }).join('');
      }

      function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      }

      // ---- Isi kotak ----
      function setBox(elId, value, colorClass) {
        const el = document.getElementById(elId);
        if (!value) {
          el.innerHTML = '—';
          el.className = 'box-value muted';
          el.style.color = '';
          return;
        }
        const match = String(value).match(/^([\d.,\s\/]+)\s*([^\d\s].*)$/);
        if (match) {
          const num  = match[1].trim();
          const unit = match[2].trim();
          el.innerHTML = `<span>${num}</span>${unit ? `<span class="kpi-unit">${unit}</span>` : ''}`;
        } else {
          el.textContent = value;
        }
        el.className = `box-value ${colorClass}`;
        el.style.color = '';
      }

      // ---- Status sync indicator ----
      function setSyncStatus(status) {
        const dot  = document.getElementById('syncDot');
        const text = document.getElementById('syncText');
        if (status === 'loading') {
          dot.style.background  = '#f59e0b';
          dot.style.animation   = 'pulse-dot 0.6s ease-in-out infinite';
          text.textContent = 'Memuat...';
        } else if (status === 'ok') {
          dot.style.background  = '#10b981';
          dot.style.animation   = 'pulse-dot 1.2s ease-in-out infinite';
          text.textContent = 'Live';
        } else {
          dot.style.background  = '#f43f5e';
          dot.style.animation   = 'none';
          text.textContent = 'Offline';
        }
      }

      // ---- Realtime subscription ----
      function subscribeRealtime() {
        supabase
          .channel('dashboard_changes')
          .on('postgres_changes', { event: '*', schema: 'public', table: 'sync_log' }, () => {
            loadDashboardData();
          })
          .subscribe();
      }

      // ---- TV Mode ----
      window.toggleTvMode = function() {
        tvActive = !tvActive;
        const btn = document.getElementById('tvBtn');
        const bar = document.getElementById('tvBar');

        if (tvActive) {
          btn.textContent = '⏹ Stop TV';
          btn.style.background = '#dc2626';
          btn.style.borderColor = '#dc2626';
          btn.style.color = '#fff';
          bar.style.display = 'flex';
          tvCombos = [];
          PRODUCTS.forEach(p => SHIFTS.forEach(s => tvCombos.push({p, s})));
          tvIndex = 0;
          runTvCycle();
        } else {
          btn.textContent = '▶ Mode TV';
          btn.style.background = '';
          btn.style.borderColor = '';
          btn.style.color = '';
          bar.style.display = 'none';
          clearTimeout(tvTimer);
          clearInterval(tvCountTimer);
        }
      };

      function runTvCycle() {
        if (!tvActive) return;
        const combo = tvCombos[tvIndex];
        productIdx = PRODUCTS.indexOf(combo.p);
        shiftIdx   = SHIFTS.indexOf(combo.s);
        updatePills();
        loadDashboardData();
        updateTvBar();

        const interval = parseInt(document.getElementById('tvInterval').value) || 8000;
        tvCountdown = Math.floor(interval / 1000);
        document.getElementById('tvBarCount').textContent = tvCountdown;

        clearInterval(tvCountTimer);
        tvCountTimer = setInterval(() => {
          tvCountdown--;
          if (tvCountdown < 0) tvCountdown = 0;
          document.getElementById('tvBarCount').textContent = tvCountdown;
        }, 1000);

        clearTimeout(tvTimer);
        tvTimer = setTimeout(() => {
          tvIndex = (tvIndex + 1) % tvCombos.length;
          runTvCycle();
        }, interval);
      }

      function updateTvBar() {
        const combo = tvCombos[tvIndex];
        if (!combo) return;
        document.getElementById('tvBarText').textContent = `▶ ${combo.p} | ${combo.s}`;
      }

      window.onTvIntervalChange = function() {
        if (!tvActive) return;
        clearTimeout(tvTimer);
        clearInterval(tvCountTimer);
        runTvCycle();
      };
    </script>

  </body>
</html>
